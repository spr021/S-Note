{
  "name": "s-note",
  "version": "1.0.0",
  "description": "Take page notes, save highlights, and attach comments to text on the web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spr021/S-Note.git"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run build:bundles && node utils/verify-extension-build.mjs && node utils/verify-content-runtime.mjs",
    "build:bundles": "vite build && vite build --config vite.content.config.ts",
    "build:hmr": "rollup --config utils/reload/rollup.config.ts",
    "build:release": "yarn build && yarn package:extensions",
    "package:extensions": "node utils/package-extension.mjs",
    "lint:firefox": "npx --yes web-ext lint --source-dir release/firefox",
    "wss": "node utils/reload/initReloadServer.js",
    "dev": "npm run build:hmr && (run-p wss dev:nodemon)",
    "dev:nodemon": "nodemon",
    "test": "jest"
  },
  "type": "module",
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^8.5.0",
    "@testing-library/react": "13.4.0",
    "@types/chrome": "0.0.210",
    "@types/jest": "29.0.3",
    "@types/node": "18.7.23",
    "@types/react": "18.0.21",
    "@types/react-dom": "18.0.6",
    "@types/ws": "^8.5.3",
    "@typescript-eslint/eslint-plugin": "5.38.1",
    "@typescript-eslint/parser": "5.38.1",
    "@vitejs/plugin-react": "2.1.0",
    "chokidar": "^3.5.3",
    "eslint": "8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.31.8",
    "fs-extra": "10.1.0",
    "jest": "29.0.3",
    "jest-environment-jsdom": "29.0.3",
    "nodemon": "2.0.20",
    "npm-run-all": "^4.1.5",
    "prettier": "2.7.1",
    "rollup": "2.79.1",
    "sass": "1.55.0",
    "ts-jest": "29.0.2",
    "ts-loader": "9.4.1",
    "typescript": "4.8.3",
    "vite": "3.1.3",
    "ws": "8.9.0"
  }
}
